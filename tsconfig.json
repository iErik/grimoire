{
  "include": [
    "app/**/*",
    "scripts/**/*",
    "env.d.ts"
  ],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2015", "es6", "ES2022"],
    "types": ["node", "vite/client", "bun"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",

    "jsx": "react-jsx",
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,

    "rootDirs": ["."],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./app/*"],
      "@layouts/*": ["./app/layouts/*"],
      "@components/*": ["./app/components/*"],
      "@views/*": ["./app/views/*"]
    }
  }
}
