{
  "include": [
    "app/**/*",
    "./styled-system/**/*",
    "scripts/**/*",
    "env.d.ts",
    "panda.config.ts"
  ],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2015", "es6", "ES2022"],
    "types": ["node", "vite/client", "bun"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",

    "jsx": "react-jsx",
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,

    "rootDirs": ["."],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./app/*"],
      "@assets/*": ["./app/assets/*"],
      "@vendor/*": ["./app/vendor/*"],
      "@layouts/*": ["./app/layouts/*"],
      "@components/*": ["./app/components/*"],
      "@views/*": ["./app/views/*"],
      "@state": ["./app/state/index.ts"],
      "@state/*": ["./app/state/*"],
      "@utils/*": ["./app/utils/*"],
      "@icons": ["./app/icons/index.tsx"],
      "@icons/*": ["./app/icons/*"],
      "@pages/*": ["./app/pages/*"],
      "@styles/*": ["./app/styles/*"],
      "@css": ["./styled-system/css"],
      "@styled-system/*": ["./styled-system/*"]
    }
  }
}
