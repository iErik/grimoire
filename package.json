{
  "name": "grimoire",
  "productName": "Grimoire",
  "repository": "iErik/grimoire",
  "version": "1.0.0-beta.1",
  "license": "GPL-2.0-only",
  "author": {
    "name": "Erik Isidore",
    "email": "ericssonico@protonmail.ch",
    "url": "https://github.com/ierik"
  },
  "bugs": {
    "url": "https://gitlab.com/Isidore/Grimoire/issues"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node --openssl-legacy-provider -r babel-register build/build.js",
    "dev": "node --openssl-legacy-provider -r babel-register build/dev-server.js",
    "start-dev": "cross-env NODE_ENV=development electron ./app/bootstrap.dev.cjs",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "build:pack": "pnpm run build && electron-builder",
    "build:pack:multi": "pnpm run build && electron-builder -mlw --x64",
    "build:pack:mac": "pnpm run build && electron-builder --mac --x64",
    "build:pack:win": "pnpm run build && electron-builder --win --x64",
    "build:pack:linux": "pnpm run build && electron-builder --linux --x64",
    "postinstall": "pnpm --dir app install",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,cjs,mjs}": "eslint --fix --no-warn-ignored"
  },
  "build": {
    "productName": "Grimoire",
    "artifactName": "${productName} Beta.${ext}",
    "appId": "org.isidore.Grimoire",
    "directories": {
      "buildResources": "resources",
      "output": "release",
      "app": "app"
    },
    "files": [
      "assets/",
      "app.html",
      "main.js",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "zip"
    },
    "linux": {
      "category": "TextEditor",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": "portable"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/parser": "^8.72.0",
    "autoprefixer": "^9.8.8",
    "babel-core": "^6.26.3",
    "babel-loader": "^7.1.5",
    "babel-plugin-add-module-exports": "^1.0.4",
    "babel-plugin-dev-expression": "^0.2.3",
    "babel-plugin-transform-class-properties": "^6.22.0",
    "babel-plugin-transform-decorators-legacy": "^1.3.4",
    "babel-plugin-transform-es2015-classes": "^6.24.1",
    "babel-polyfill": "^6.23.0",
    "babel-preset-env": "^1.4.0",
    "babel-preset-react": "^6.22.0",
    "babel-preset-stage-0": "^6.22.0",
    "babel-register": "^6.22.0",
    "cross-env": "5.1.3",
    "css-loader": "^0.28.1",
    "electron": "^37.3.1",
    "electron-builder": "^19.45.0",
    "electron-debug": "^1.1.0",
    "electron-devtools-installer": "^4.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "express": "^4.14.1",
    "extract-text-webpack-plugin": "3.0.2",
    "file-loader": "1.1.6",
    "friendly-errors-webpack-plugin": "^1.6.1",
    "globals": "^17.13.0",
    "html-webpack-plugin": "^2.28.0",
    "husky": "^9.1.7",
    "json-loader": "^0.5.4",
    "lint-staged": "^17.6.0",
    "minimist": "^1.2.0",
    "node-sass-json-importer": "^4.3.0",
    "ora": "^1.1.0",
    "postcss-loader": "2.0.10",
    "react-hot-loader": "^1.3.1",
    "redux-logger": "^2.8.1",
    "resolve-url-loader": "^2.2.0",
    "sass": "^1.80.0",
    "sass-loader": "^7.3.1",
    "shelljs": "0.8.0",
    "style-loader": "^0.19.1",
    "typescript": "~5.9.3",
    "url-loader": "0.6.2",
    "webpack": "3.10.0",
    "webpack-dev-middleware": "2.0.4",
    "webpack-hot-middleware": "^2.18.0",
    "webpack-merge": "^4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ],
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "fsevents",
      "uglifyjs-webpack-plugin"
    ]
  }
}
